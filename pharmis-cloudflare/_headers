# Cloudflare Pages — en-têtes HTTP
# Réservé aux professionnels de santé (loi 73-55, art. 40) : pas d'indexation par les moteurs de recherche.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# Toujours vérifier la dernière version de l'application et du service worker
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
